# --- Database ---
POSTGRES_USER=phishsim
POSTGRES_PASSWORD=change-me
POSTGRES_DB=phishing_sim
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
# App runtime uses asyncpg; Alembic derives a psycopg2 URL from this automatically.
DATABASE_URL=postgresql+asyncpg://phishsim:change-me@postgres:5432/phishing_sim

# --- Redis / Celery ---
REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/1

# --- Auth ---
SECRET_KEY=change-me-to-a-long-random-string
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7
ALGORITHM=HS256

# Fernet key encrypting SMTP passwords and captured credentials at rest.
# Generate your own per environment - never reuse this example value:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
ENCRYPTION_KEY=n6R55QZWgRYbjPbk9yMtAw7RV-dfEjrKviwv93OwBRc=

# HMAC key signing tracking-link UUIDs (CampaignTarget.tracking_sig).
TRACKING_HMAC_SECRET=change-me-tracking-hmac-secret

# API key for an LLM/AI provider, used by any future AI-assisted feature.
# Leave blank unless such a feature is enabled.
LLM_API_KEY=

# --- SMTP relay used to send simulated phishing emails ---
# Only point this at mail infrastructure you are authorized to send through,
# and only use this platform against targets covered by a signed engagement/
# security-awareness authorization.
SMTP_HOST=smtp.example.internal
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_USE_TLS=true
SMTP_DEFAULT_SENDER=training@example.internal

# --- App ---
APP_BASE_URL=http://localhost:8080
ENVIRONMENT=development
CORS_ORIGINS=http://localhost:5173,http://localhost:8080
